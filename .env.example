# ---------------------------------------------------------------------------
# Frontend (.env.local) — written for you by `npx convex dev` (local deployment)
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=local:<generated-name>
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# ---------------------------------------------------------------------------
# Production deploy (.env.prod.local — git-ignored, read by scripts/deploy.sh)
# ---------------------------------------------------------------------------
# CONVEX_DEPLOY_KEY=prod:<production deploy key>
# DEPLOY_HOST=user@your-server
# DEPLOY_PORT=22
# DEPLOY_DIR=/var/www/class

# ---------------------------------------------------------------------------
# Convex-side env vars — set on EACH deployment with `npx convex env set`
# (NOT read from this file)
# ---------------------------------------------------------------------------
# SITE_URL=http://localhost:5173
# TEACHER_EMAILS=teacher@example.com,other.teacher@example.com
# JWT_PRIVATE_KEY=...   } generate both with: node scripts/setup-auth-keys.ts --apply
# JWKS=...              }
