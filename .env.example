# ---------------------------------------------------------------------------
# Dev (backend/.env.local) — written for you by `npx convex dev` in backend/ (local)
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=local:<generated-name>
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# ---------------------------------------------------------------------------
# Production deploy (git-ignored, read by scripts/deploy.sh)
# ---------------------------------------------------------------------------
# backend/.env.prod.local
# CONVEX_DEPLOY_KEY=prod:<production deploy key>
#
# web/.env.prod.local
# DEPLOY_HOST=user@your-server
# DEPLOY_PORT=22
# DEPLOY_DIR=/var/www/class

# ---------------------------------------------------------------------------
# Convex-side env vars — set on EACH deployment with `npx convex env set`
# (NOT read from this file)
# ---------------------------------------------------------------------------
# SITE_URL=http://localhost:5173
# ALLOWED_EMAILS=teacher@example.com,other.teacher@example.com
# JWT_PRIVATE_KEY=...   } generate both with: npm run setup:auth (in backend/)
# JWKS=...              }
