# ---------------------------------------------------------------------------
# .env.local — written for you by `npx convex dev` here (local deployment);
# the web app reads it too
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=local:<generated-name>
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# ---------------------------------------------------------------------------
# .env.prod.local — git-ignored, read by ../scripts/deploy.sh
# ---------------------------------------------------------------------------
# CONVEX_DEPLOY_KEY=prod:<production deploy key>

# ---------------------------------------------------------------------------
# Convex deployment env vars: set on EACH deployment with
# `npx convex env set` (add --prod for production), not read from a file
# ---------------------------------------------------------------------------
# SITE_URL=http://localhost:5173
# ALLOWED_EMAILS=teacher@example.com,other.teacher@example.com
# JWT_PRIVATE_KEY=...   } generate both with: npm run setup:auth
# JWKS=...              }
